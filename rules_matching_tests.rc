#include <windows.h>
#include "resource.h"

/* Манифест нейтрального языка должен находиться на любой локали Windows. */
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
1 24 "rules_matching_tests.manifest"

/* Тесты используют настоящие сообщения об ошибках и имена правил:
