/* ======================== локализованные диалоги ========================
   Ресурс версии есть только на русском и английском: Explorer показывает его
   по языку системы, а не по выбранному в программе, и при отсутствии нужной
   локали берёт первую доступную. Дублировать номера версии на каждый язык
   смысла нет. */
#include "firewall_dialogs_ru.rc"
#include "firewall_dialogs_en.rc"
